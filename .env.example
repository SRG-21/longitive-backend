# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# eco = Vercel serverless, no Redis. pro = long-running server, Redis-backed queues/throttling.
APP_MODE=eco

# Database — local dev uses the docker-compose mongo replica set (line below).
# For MongoDB Atlas, replace this single line with your Atlas connection string
# (Atlas dashboard -> Database -> Connect -> Drivers -> Node.js), keeping the
# database name and adding retryWrites/majority, e.g.:
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/longevity_db?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/longevity_db?replicaSet=rs0

# Redis (pro mode only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# AWS S3 (all file storage — lab report/body comp uploads, always S3 in every mode)
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mistral OCR
MISTRAL_API_KEY=

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@longevity.app

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
